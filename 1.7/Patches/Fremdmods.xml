<?xml version="1.0" encoding="utf-8" ?>
<Patch>

	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Celestial Lighting</li>
		</mods>
		<match Class="PatchOperationSequence">
			<success>Always</success>
			<operations>
				<li Class="PatchOperationAdd">
					<xpath>Defs/ShaderDef[defName="WR_Shadow"]/shaderProgram</xpath>
					<value>
						<cullMode>None</cullMode>
					</value>
				</li>
				<li Class="PatchOperationAdd">
					<xpath>Defs/ShaderDef[defName="WR_ShadowTorch"]/shaderProgram</xpath>
					<value>
						<cullMode>None</cullMode>
					</value>
				</li>
			</operations>
		</match>
	</Operation>

</Patch>
